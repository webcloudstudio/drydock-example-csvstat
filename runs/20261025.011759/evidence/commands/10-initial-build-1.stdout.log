BLOCK block-2  name="Block 2 · Service"  calls_max=7
  story=build-executable  "Build the csvstat executable with go build using only the standard library."
  story=csv-reader  "Read the CSV file with encoding/csv and trim the header and every value."
  story=read-failure  "Report an unopenable or unreadable file, including a directory, with exit 1."
  story=null-values  "Classify empty, NA, N/A, and NULL values as null after trimming."
  story=type-numeric  "Infer the integer and number column types."
  story=type-date  "Infer the date column type with real calendar validation."
  story=median  "Compute the exact median for numeric columns."
  story=counts  "Count rows, nulls, and distinct non-null values for each column."
  story=type-other  "Infer the boolean, text, and empty column types."
  story=sum-mean  "Compute exact sum and mean for numeric columns, rounded once half away from zero."
  story=min-max  "Report min and max for every column type."
  story=input-rejection  "Reject empty, malformed, or ragged files with exit 3 and a diagnostic on standard error."
  story=arguments  "Parse arguments and reject malformed usage with exit 2 and a usage line."
  story=profile-output  "Write the profile table for every column in file order."
  story=column-select  "Profile only the column named by --column and exit 3 when it is absent."
  story=frequency  "List the most frequent values of a column ordered by count then value."
  story=frequency-top  "Limit frequency rows with --top and reject non-positive values with exit 2."
  story=test-runner  "Provide the POSIX bin/test.sh that runs go vet and go test."

