    "INSTRUCTIONS.md": {
      "state": "current",
      "versions": [
        {
          "commit": "d94d00c",
          "date": "2026-10-23",
          "hash": "a4a0357965923ada8afb3528e85c937802a26eb02db8685900dbe0e9566c7a57",
          "release": "",
          "state": "consumed",
          "via": "plan",
          "ticket": null,
          "requirements": [
            {
              "name": "build-go-cli",
              "text": "Implement in Go 1.22 or newer using only the standard library. The application root is a Go module, and its executable is the main package at `./cmd/csvstat`. Tests run under `go test`.",
              "stories": [
                "cli-foundation"
              ]
            },
            {
              "name": "run-conformance-harness",
              "text": "The harness runs `go build -o <temporary path> ./cmd/csvstat` and then runs 22 checks.",
              "stories": [
                "full-verification"
              ]
            },
            {
              "name": "read-validate-csv",
              "text": "The file is **rejected** when it is empty, when a header name is empty or repeated, or when any record has a different number of fields from the header.",
              "stories": [
                "cli-input"
              ]
            },
            {
              "name": "resolve-columns-null-values",
              "text": "Every header name and every value is trimmed of leading and trailing spaces before any other rule applies.",
              "stories": [
                "cli-columns"
              ]
            },
            {
              "name": "infer-column-types",
              "text": "A column's type is the first of these that every non-null value satisfies:",
              "stories": [
                "profile-types"
              ]
            },
            {
              "name": "compute-profile-statistics",
              "text": "Header `column,type,rows,nulls,distinct,min,max,sum,mean,median`, then one row per column in file order (or the one named by `--column`).",
              "stories": [
                "profile-statistics"
              ]
            },
            {
              "name": "render-profile-csv",
              "text": "CSV on standard output with `\\n` line endings.",
              "stories": [
                "profile-output"
              ]
            },
            {
              "name": "list-frequent-values",
              "text": "Header `value,count`, then one row per distinct non-null value of the column, ordered by count descending, then value ascending by byte value, at most `--top` rows.",
              "stories": [
                "frequency-values"
              ]
            },
            {
              "name": "limit-frequency-rows",
              "text": "`--top <n>` | With `--freq`, list at most `<n>` values. A positive integer; default `5`.",
              "stories": [
                "frequency-limits"
              ]
            },
            {
              "name": "map-command-failures",
              "text": "A failing command writes nothing to standard output and one diagnostic line to standard error naming the file and, for a rejected record, its line number.",
              "stories": [
                "cli-errors"
              ]
            },
            {
              "name": "provide-test-gate",
              "text": "The completed application provides a POSIX-compatible `bin/test.sh` that runs `go vet ./...` and `go test ./...` from the application root and exits zero only when both pass.",
              "stories": [
                "test-gate"
              ]
            }
          ]
        }
      ]
    },
