BLOCK block-2  name="Block 2 · Service"  calls_max=7
  story=module-build  "Prove the application root builds csvstat with go build using only the standard library."
  story=csv-reading  "Read a UTF-8 RFC 4180 file with encoding/csv into a header and data records."
  story=null-trim  "Trim header names and values and classify null values."
  story=unreadable-file  "Exit 1 when the file cannot be opened or read."
  story=row-counts  "Count rows, nulls, and distinct non-null values per column."
  story=reject-malformed  "Reject empty files, empty or repeated header names, and ragged records with exit 3."
  story=cli-options  "Parse --column, --freq, --top, and the single file argument."
  story=column-select  "Profile only the column named by --column, rejecting an absent name with exit 3."
  story=usage-errors  "Reject usage errors with exit 2 and both synopses on standard error."
  story=type-inference  "Infer integer, number, boolean, text, and empty column types."
  story=date-type  "Recognize date columns with real calendar validation."
  story=frequencies  "List the most frequent non-null values of a column with --freq."
  story=min-max  "Compute min and max per column type."
  story=numeric-stats  "Compute exact sum, mean, and median for integer and number columns."
  story=csv-output  "Write profile and frequency output as CSV with newline line endings."
  story=test-script  "Provide bin/test.sh running go vet and go test from the application root."

